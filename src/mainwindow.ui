  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #ffffff;
    font-family: "Segoe UI";
}

#titleLabel {
    color: #1f2937;
    font-size: 26px;
    font-weight: bold;
}

#subtitleLabel {
    color: #6b7280;
    font-size: 13px;
}

#nameLabel {
    color: #222222;
    font-size: 14px;
    font-weight: bold;
}

#totalLabel, #doneLabel, #remainingLabel {
    color: #374151;
    font-size: 14px;
    padding: 4px 0;
}

QLineEdit {
    background-color: #ffffff;
    border: 1px solid #cfd8dc;
    border-radius: 8px;
    padding: 9px 12px;
    font-size: 14px;
}

QLineEdit:focus {
    border: 1px solid #22c55e;
}

QListWidget {
    background-color: #f5f7fa;
    border: 1px solid #d9e1e8;
    border-radius: 8px;
    padding: 6px;
    font-size: 14px;
}

QListWidget::item {
    padding: 8px;
}

QListWidget::item:selected {
    background-color: #d8eaff;
    color: #0d47a1;
}

QPushButton {
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 14px;
    font-weight: bold;
}

#btnAdd {
    background-color: #22c55e;
}

#btnAdd:hover {
    background-color: #16a34a;
}

#btnComplete {
    background-color: #2563eb;
}

#btnComplete:hover {
    background-color: #1d4ed8;
}

#btnDelete {
    background-color: #ef4444;
}

#btnDelete:hover {
    background-color: #dc2626;
}</string>
